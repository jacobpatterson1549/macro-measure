{
  "name": "macro-measure",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "@testing-library/jest-dom": "^5.12.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/react-hooks": "^7.0.0",
    "babel-preset-react-app": "^10.0.1",
    "geolocation-utils": "^1.2.5",
    "jest": "^27.4.3",
    "react": "^17.0.2"
  },
  "scripts": {
    "generate-build": "node src/generate-build.js",
    "clean": "echo 'build coverage node_modules' | xargs rm -rf",
    "build": "cp -R public build && esbuild src/index.js --bundle --loader:.js=jsx --outfile=build/index.js --entry-names=[name]-[hash] && npm run generate-build",
    "dev": "npm run build && esbuild --servedir=build --serve=localhost:3000",
    "test": "jest",
    "test-dev": "jest --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/jestCssMock.js"
    },
    "transform": {
      "^.+\\.js$": "<rootDir>/src/jestBabelTransform.js"
    },
    "resetMocks": true
  }
}
